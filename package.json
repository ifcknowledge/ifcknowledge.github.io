{
  "name": "ifc-knowledge-news",
  "version": "1.0.0",
  "private": true,
  "description": "IFC knowledge — free Hindi + English news website (Eleventy + Sveltia CMS + GitHub Pages)",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve --quiet",
    "build": "eleventy",
    "clean": "node -e \"require('node:fs').rmSync('_site',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-fetch": "^6.0.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0"
  }
}
