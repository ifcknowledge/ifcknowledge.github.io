{%- set nameParts = site.name | splitName %}
<a class="logo" href="/" aria-label="{{ site.name }} — होम">
  {#- Round badge with the site name inside, like the round logos of TV news channels #}
  <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true">
    <circle cx="32" cy="32" r="32" fill="#fff"/>
    <circle cx="32" cy="32" r="28.5" fill="#d10014"/>
    <circle cx="32" cy="32" r="25.5" fill="none" stroke="#fff" stroke-opacity=".35" stroke-width=".8"/>
    <text x="32" y="33.5" text-anchor="middle" fill="#fff" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="21" textLength="36" lengthAdjust="spacingAndGlyphs">{{ nameParts[0] }}</text>
    {%- if nameParts[1] %}
    <text x="32" y="44.5" text-anchor="middle" fill="#fff" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="8.6" textLength="38" lengthAdjust="spacingAndGlyphs">{{ nameParts[1] }}</text>
    {%- endif %}
    <path d="M17 49.5h30" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity=".7"/>
  </svg>
  <span class="logo__text">
    <span class="logo__name"><b>{{ nameParts[0] }}</b>{% if nameParts[1] %} {{ nameParts[1] }}{% endif %}</span>
    <span class="logo__tag">{{ site.tagline }}</span>
  </span>
</a>
