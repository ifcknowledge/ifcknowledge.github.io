{%- from "partials/icons.njk" import icon -%}
{%- set pageTitle = (title + " | " + site.name) if title else (site.name + " — " + site.tagline) -%}
{%- set pageDesc = (summary or description or site.description) | striptags | truncate(170, true, "…") -%}
{%- set ytid = youtube | youtubeId -%}
{%- if image -%}{%- set ogImage = image | absUrl -%}
{%- elif ytid -%}{%- set ogImage = "https://i.ytimg.com/vi/" + ytid + "/hqdefault.jpg" -%}
{%- else -%}{%- set ogImage = "/assets/img/og-default.png" | absUrl -%}{%- endif -%}
<!doctype html>
<html lang="{{ lang or site.language or 'hi' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <meta name="robots" content="max-image-preview:large">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | absUrl }}">
  <meta name="theme-color" content="#002665">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ page.url | absUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:locale" content="hi_IN">
  {%- if isArticle %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}
  <meta property="article:section" content="{{ (category | categoryInfo).name }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&amp;display=swap">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>try{var t=localStorage.getItem("theme");if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
</head>
<body>
  <a class="skip-link" href="#main">मुख्य खबर पर जाएं</a>
  {%- set hasVideos = site.show_videos and channel.videos.length %}
  {%- set liveUrl = (site.youtube_url | replace("?sub_confirmation=1", "")) + "/live" if site.youtube_url else "" %}

  <div class="utility">
    <div class="container utility__inner">
      <span class="utility__date"><span data-today>{{ build.now | hiWeekdayDate }}</span><span class="utility__clock" data-clock></span></span>
      <nav class="utility__links" aria-label="जल्दी पहुंचें">
        <a href="/news/">ताज़ा खबरें</a>
        {%- if hasVideos %}<a href="/videos/">वीडियो</a>{% endif %}
        {%- for p in collections.sitePages | head(2) %}<a href="{{ p.url }}">{{ p.data.title }}</a>{% endfor %}
      </nav>
      <div class="utility__right">
        <div class="lang-switch notranslate" translate="no" role="group" aria-label="भाषा · Language" data-lang-switch>
          <a href="{{ page.url | absUrl }}" data-lang="hi" lang="hi" aria-current="true">हिंदी</a>
          <a href="{{ page.url | englishUrl }}" data-lang="en" lang="en">English</a>
        </div>
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="लाइट / डार्क मोड बदलें">{{ icon("sun", "icon-sun") }}{{ icon("moon", "icon-moon") }}</button>
        {%- if site.youtube_url %}
        <a class="sub-btn" href="{{ site.youtube_url }}?sub_confirmation=1" target="_blank" rel="noopener">{{ icon("youtube") }} Subscribe</a>
        {%- endif %}
      </div>
    </div>
  </div>

  {%- set activeCat = category if isArticle else (cp.cat.slug if cp else "") %}
  <header class="masthead">
    <div class="container masthead__inner">
      <a class="masthead__menu" href="#site-footer" data-menu-open aria-controls="site-menu" aria-expanded="false" aria-label="मेन्यू खोलें">{{ icon("menu") }}</a>
      {% include "partials/logo.njk" %}
      <div class="masthead__tools">
        {%- if liveUrl %}
        <a class="live-btn" href="{{ liveUrl }}" target="_blank" rel="noopener" aria-label="YouTube पर लाइव देखें">LIVE</a>
        {%- endif %}
        <a class="masthead__search" href="/search/" aria-label="खबर खोजें">{{ icon("search") }}</a>
      </div>
    </div>
    <nav class="main-nav" aria-label="खबरों की श्रेणियां">
      <div class="container">
        <ul>
          <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>होम</a></li>
          {%- for c in categories.list %}
          <li><a href="/category/{{ c.slug }}/"{% if activeCat == c.slug %} class="is-active"{% if cp and cp.pageNumber == 0 %} aria-current="page"{% endif %}{% endif %}>{{ c.name }}</a></li>
          {%- endfor %}
          {%- if hasVideos %}
          <li><a href="/videos/"{% if page.url == "/videos/" %} aria-current="page"{% endif %}>वीडियो</a></li>
          {%- endif %}
        </ul>
      </div>
    </nav>
  </header>

  {%- set tickerItems = collections.news | breaking(6) %}
  {%- if tickerItems.length or site.ticker.length %}
  <div class="breaking-wrap" data-breaking>
    <div class="container">
      <div class="breaking" role="region" aria-label="ब्रेकिंग न्यूज़">
        <span class="breaking__label" lang="en">BREAKING NEWS</span>
        <div class="breaking__track">
          <ul class="breaking__list">
            {%- for loopNo in [1, 2] %}
            {%- for line in site.ticker %}<li{% if loopNo == 2 %} aria-hidden="true"{% endif %}>{{ line }}</li>{% endfor %}
            {%- for p in tickerItems %}<li{% if loopNo == 2 %} aria-hidden="true"{% endif %}><a href="{{ p.url }}"{% if loopNo == 2 %} tabindex="-1"{% endif %}>{{ p.data.title }}</a></li>{% endfor %}
            {%- endfor %}
          </ul>
        </div>
        <button class="breaking__close" type="button" data-breaking-close aria-label="ब्रेकिंग पट्टी बंद करें">{{ icon("close") }}</button>
      </div>
    </div>
  </div>
  {%- endif %}

  <div class="chips-wrap">
    <div class="container chips" data-scroller>
      <span class="chips__title">ट्रेंडिंग</span>
      <button class="scroll-btn" type="button" data-scroll="-1" aria-label="पीछे" hidden>{{ icon("chev-left") }}</button>
      <ul class="chips__list" data-scroll-track>
        {%- for c in categories.list %}<li><a class="chip{% if activeCat == c.slug %} is-active{% endif %}" href="/category/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}
        {%- if hasVideos %}<li><a class="chip" href="/videos/">वीडियो</a></li>{% endif %}
      </ul>
      <button class="scroll-btn" type="button" data-scroll="1" aria-label="आगे" hidden>{{ icon("chev-right") }}</button>
    </div>
  </div>

  <main id="main" class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer" id="site-footer">
    <div class="container">
      <div class="footer__grid">
        <div>
          {% include "partials/logo.njk" %}
          <p>{{ site.about_short }}</p>
          <div class="social">
            {%- if site.youtube_url %}<a href="{{ site.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">{{ icon("youtube") }}</a>{% endif %}
            {%- if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{{ icon("facebook") }}</a>{% endif %}
            {%- if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{{ icon("instagram") }}</a>{% endif %}
            {%- if site.social.x %}<a href="{{ site.social.x }}" target="_blank" rel="noopener" aria-label="X (Twitter)">{{ icon("x") }}</a>{% endif %}
            {%- if site.social.telegram %}<a href="{{ site.social.telegram }}" target="_blank" rel="noopener" aria-label="Telegram">{{ icon("telegram") }}</a>{% endif %}
            {%- if site.social.whatsapp %}<a href="{{ site.social.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ icon("whatsapp") }}</a>{% endif %}
            {%- if site.email %}<a href="mailto:{{ site.email }}" aria-label="ईमेल">{{ icon("mail") }}</a>{% endif %}
            <a href="/feed.xml" aria-label="RSS फ़ीड">{{ icon("rss") }}</a>
          </div>
        </div>
        <div>
          <h2>श्रेणियां</h2>
          <ul class="footer__cats">
            {%- for c in categories.list %}<li><a href="/category/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}
          </ul>
        </div>
        <div>
          <h2>जानकारी</h2>
          <ul>
            {%- for p in collections.sitePages %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
            <li><a href="/news/">सभी खबरें</a></li>
            {%- if hasVideos %}<li><a href="/videos/">वीडियो</a></li>{% endif %}
            <li><a href="/search/">खोजें</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© {{ build.year }} {{ site.name }}. सर्वाधिकार सुरक्षित।</span>
        <span>{{ site.tagline }}</span>
      </div>
    </div>
  </footer>

  {#- Side menu (opened by ☰ and the bottom "मेन्यू" tab; without JavaScript those links jump to the footer) #}
  <div class="drawer" id="site-menu" data-menu hidden>
    <div class="drawer__backdrop" data-menu-close></div>
    <nav class="drawer__panel" aria-label="मेन्यू">
      <div class="drawer__head">
        {% include "partials/logo.njk" %}
        <button class="drawer__close" type="button" data-menu-close aria-label="मेन्यू बंद करें">{{ icon("close") }}</button>
      </div>
      <ul class="drawer__list">
        <li><a href="/">{{ icon("home") }} होम</a></li>
        <li><a href="/news/">{{ icon("clock") }} ताज़ा खबरें</a></li>
        {%- for c in categories.list %}<li><a href="/category/{{ c.slug }}/"><span class="drawer__dot" style="--c: {{ c.color }}"></span>{{ c.name }}</a></li>{% endfor %}
        {%- if hasVideos %}<li><a href="/videos/">{{ icon("play") }} वीडियो</a></li>{% endif %}
        <li><a href="/search/">{{ icon("search") }} खोजें</a></li>
      </ul>
      <div class="drawer__lang">
        <span>भाषा · Language</span>
        <div class="lang-switch notranslate" translate="no" role="group" aria-label="भाषा · Language" data-lang-switch>
          <a href="{{ page.url | absUrl }}" data-lang="hi" lang="hi" aria-current="true">हिंदी</a>
          <a href="{{ page.url | englishUrl }}" data-lang="en" lang="en">English</a>
        </div>
      </div>
      <ul class="drawer__list drawer__list--small">
        {%- for p in collections.sitePages %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
      </ul>
    </nav>
  </div>

  {#- Bottom tab bar on phones #}
  <nav class="tabbar" aria-label="मुख्य मेन्यू">
    <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>{{ icon("home") }}<span>होम</span></a>
    {%- if hasVideos %}<a href="/videos/"{% if page.url == "/videos/" %} aria-current="page"{% endif %}>{{ icon("play") }}<span>वीडियो</span></a>{% endif %}
    {%- if liveUrl %}<a class="tabbar__live" href="{{ liveUrl }}" target="_blank" rel="noopener"><span class="live-btn">LIVE</span><span>लाइव टीवी</span></a>{% endif %}
    <a href="/search/"{% if page.url == "/search/" %} aria-current="page"{% endif %}>{{ icon("search") }}<span>खोजें</span></a>
    <a href="#site-footer" data-menu-open aria-controls="site-menu" aria-expanded="false">{{ icon("grid") }}<span>मेन्यू</span></a>
  </nav>

  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
</body>
</html>
