{%- from "partials/icons.njk" import icon -%}
{%- set pageTitle = (title + " | " + site.name) if title else (site.name + " — " + site.tagline) -%}
{%- set pageDesc = (summary or description or site.description) | striptags | truncate(170, true, "…") -%}
{%- set ytid = youtube | youtubeId -%}
{%- if image -%}{%- set ogImage = image | absUrl -%}
{%- elif ytid -%}{%- set ogImage = "https://i.ytimg.com/vi/" + ytid + "/hqdefault.jpg" -%}
{%- else -%}{%- set ogImage = "/assets/img/og-default.png" | absUrl -%}{%- endif -%}
<!doctype html>
<html lang="{{ lang or site.language or 'hi' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  {%- if noindex %}
  <meta name="robots" content="noindex">
  {%- else %}
  <meta name="robots" content="max-image-preview:large">
  {%- endif %}
  <link rel="canonical" href="{{ page.url | absUrl }}">
  <meta name="theme-color" content="#c8102e">

  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ page.url | absUrl }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:locale" content="hi_IN">
  {%- if isArticle %}
  <meta property="article:published_time" content="{{ page.date | isoDate }}">
  {%- if updated %}<meta property="article:modified_time" content="{{ updated | isoDate }}">{% endif %}
  <meta property="article:section" content="{{ (category | categoryInfo).name }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="/feed.xml">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mukta:wght@400;500;600;700;800&amp;display=swap">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build.version }}">
  <script>try{var t=localStorage.getItem("theme");if(t==="dark"||t==="light")document.documentElement.setAttribute("data-theme",t)}catch(e){}</script>
</head>
<body>
  <a class="skip-link" href="#main">मुख्य खबर पर जाएं</a>

  <div class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__date" data-today>{{ build.now | hiWeekdayDate }}</span>
      <div class="topbar__right">
        {%- if site.youtube_url %}
        <a class="yt-sub" href="{{ site.youtube_url }}?sub_confirmation=1" target="_blank" rel="noopener">{{ icon("youtube") }} Subscribe</a>
        {%- endif %}
        <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="लाइट / डार्क मोड बदलें">{{ icon("sun", "icon-sun") }}{{ icon("moon", "icon-moon") }}</button>
      </div>
    </div>
  </div>

  <header class="site-header">
    <div class="container header__inner">
      {% include "partials/logo.njk" %}
      <form class="header-search" action="/search/" method="get" role="search">
        <label class="visually-hidden" for="header-q">खबर खोजें</label>
        <input id="header-q" type="search" name="q" placeholder="खबर खोजें… Search news" autocomplete="off">
        <button type="submit" aria-label="खोजें">{{ icon("search") }}</button>
      </form>
      <a class="search-link" href="/search/" aria-label="खबर खोजें">{{ icon("search") }}</a>
    </div>
  </header>

  {%- set activeCat = category if isArticle else (cp.cat.slug if cp else "") %}
  <nav class="site-nav" aria-label="खबरों की श्रेणियां">
    <div class="container">
      <ul>
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>होम</a></li>
        {%- for c in categories.list %}
        <li><a href="/category/{{ c.slug }}/"{% if activeCat == c.slug %} class="is-active"{% if cp and cp.pageNumber == 0 %} aria-current="page"{% endif %}{% endif %}>{{ c.name }}</a></li>
        {%- endfor %}
        {%- if site.show_videos and channel.videos.length %}
        <li><a href="/videos/"{% if page.url == "/videos/" %} aria-current="page"{% endif %}>वीडियो</a></li>
        {%- endif %}
      </ul>
    </div>
  </nav>

  {%- set tickerItems = collections.news | breaking(6) %}
  {%- if tickerItems.length or site.ticker.length %}
  <div class="ticker" aria-label="ब्रेकिंग न्यूज़">
    <div class="container ticker__inner">
      <span class="ticker__label">ब्रेकिंग</span>
      <div class="ticker__track">
        <ul class="ticker__list">
          {%- for loopNo in [1, 2] %}
          {%- for line in site.ticker %}<li{% if loopNo == 2 %} aria-hidden="true"{% endif %}>{{ line }}</li>{% endfor %}
          {%- for p in tickerItems %}<li{% if loopNo == 2 %} aria-hidden="true"{% endif %}><a href="{{ p.url }}"{% if loopNo == 2 %} tabindex="-1"{% endif %}>{{ p.data.title }}</a></li>{% endfor %}
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
  {%- endif %}

  <main id="main" class="container">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer__grid">
        <div>
          {% include "partials/logo.njk" %}
          <p>{{ site.about_short }}</p>
          <div class="social">
            {%- if site.youtube_url %}<a href="{{ site.youtube_url }}" target="_blank" rel="noopener" aria-label="YouTube">{{ icon("youtube") }}</a>{% endif %}
            {%- if site.social.facebook %}<a href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{{ icon("facebook") }}</a>{% endif %}
            {%- if site.social.instagram %}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{{ icon("instagram") }}</a>{% endif %}
            {%- if site.social.x %}<a href="{{ site.social.x }}" target="_blank" rel="noopener" aria-label="X (Twitter)">{{ icon("x") }}</a>{% endif %}
            {%- if site.social.telegram %}<a href="{{ site.social.telegram }}" target="_blank" rel="noopener" aria-label="Telegram">{{ icon("telegram") }}</a>{% endif %}
            {%- if site.social.whatsapp %}<a href="{{ site.social.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ icon("whatsapp") }}</a>{% endif %}
            {%- if site.email %}<a href="mailto:{{ site.email }}" aria-label="ईमेल">{{ icon("mail") }}</a>{% endif %}
            <a href="/feed.xml" aria-label="RSS फ़ीड">{{ icon("rss") }}</a>
          </div>
        </div>
        <div>
          <h2>श्रेणियां</h2>
          <ul>
            {%- for c in categories.list %}<li><a href="/category/{{ c.slug }}/">{{ c.name }}</a></li>{% endfor %}
          </ul>
        </div>
        <div>
          <h2>जानकारी</h2>
          <ul>
            {%- for p in collections.sitePages %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endfor %}
            <li><a href="/news/">सभी खबरें</a></li>
            {%- if site.show_videos and channel.videos.length %}<li><a href="/videos/">वीडियो</a></li>{% endif %}
            <li><a href="/search/">खोजें</a></li>
          </ul>
        </div>
      </div>
      <div class="footer__bottom">
        <span>© {{ build.year }} {{ site.name }}. सर्वाधिकार सुरक्षित।</span>
        <span>{{ site.tagline }}</span>
      </div>
    </div>
  </footer>

  <script src="/assets/js/main.js?v={{ build.version }}" defer></script>
</body>
</html>
